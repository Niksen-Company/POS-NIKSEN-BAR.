# Production Database
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Production Session (use a long random secret)
SESSION_SECRET=replace-with-64-plus-random-characters

# Google OAuth (production app credentials)
GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# Runtime
NODE_ENV=production
PORT=5000

# Restrict Google sign-ins to your company domain, or use * to allow all
ALLOWED_DOMAIN=yourcompany.com

# Discord Bot (optional – used for order/alert notifications)
DISCORD_BOT_SECRET=your-discord-bot-token
